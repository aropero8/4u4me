# Copia este archivo como .env y rellena los valores de tu proyecto de Supabase
# (Project Settings → API). La clave "anon" es pública: la seguridad la dan las
# políticas RLS de supabase/schema.sql. Nunca pongas aquí la clave service_role.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
